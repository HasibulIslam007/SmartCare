# ============================================================
# SmartCare HMS - Git ignore
# ============================================================

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# ---------- Environment / secrets ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
!.env.sample

# ---------- Node.js / npm / yarn / pnpm ----------
node_modules/
node_modules/.cache/
.npm/
.yarn/
.yarnrc
.pnpm-store/
.pnpm-state/
.yarn-integrity
.yarn/cache/
.yarn/unplugged/

# ---------- Build outputs ----------
dist/
build/
out/
next-env.d.ts
*.tsbuildinfo

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Tests / coverage ----------
coverage/
.nyc_output/
test/reports/
coverage-final.json

# ---------- Prisma generated client ----------
# Regenerated automatically by `prisma generate` / `npm run build`
backend/src/generated/

# ---------- Local development data (Postgres etc.) ----------
.local/

# ---------- IDEs / editors ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
.cursor/
.codex/
.cline/
.claude/
.antigravity-ide/
.vscode-shared/

# ---------- Temporary / misc ----------
*.tmp
*.bak
*.orig
*.pid
*.pid.lock
.cache/
.caches/
.tmp/

# ---------- Frontend (Next.js, planned) ----------
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
frontend/.env*
frontend/.vercel/

# ---------- Mobile (Flutter, planned) ----------
mobile/.dart_tool/
mobile/build/
mobile/flutter_export_environment.sh
mobile/flutter_*.png
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/.idea/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/ephemeral/

# ---------- Windows ----------
Thumbs.db
ehthumbs.db
Desktop.ini

# Keep the frontend environment template versioned.
!frontend/.env.example
