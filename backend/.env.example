NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://smartcare:local-development-only@localhost:5432/smartcare
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://127.0.0.1:3000

# Staff two-factor authentication. Optional; when unset the TOTP secret is
# encrypted with a key derived from JWT_SECRET. Set a dedicated value in
# production, and note that changing it invalidates enrolled authenticators.
# MFA_ENCRYPTION_KEY=

# Transactional email for verification and password reset. Without an API key
# the message is logged instead of sent, so local development needs no account.
# RESEND_API_KEY=
# RESEND_EMAIL_FROM=SmartCare <no-reply@your-domain.example>

# Medical report storage. Keep local for development only; production must use a private S3-compatible bucket.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local/storage/reports
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false
